{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Job Search OS tracker configuration",
  "type": "object",
  "required": ["schema_version", "mode", "google_sheet_url", "verified_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["local_json", "google_sheets"] },
    "google_sheet_url": { "type": ["string", "null"], "format": "uri" },
    "verified_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "google_sheets" } } },
      "then": {
        "properties": {
          "google_sheet_url": {
            "type": "string",
            "pattern": "^https://docs\\.google\\.com/spreadsheets/"
          },
          "verified_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ],
  "additionalProperties": false
}
